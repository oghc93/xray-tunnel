<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:openDrawer="start">

    <!-- Konten Utama -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0B0F19">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#0F172A"
            app:elevation="0dp">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:title="XrayLite"
                app:titleTextColor="#FFFFFF" />

        </com.google.android.material.appbar.AppBarLayout>

        <!-- Area Scroll Utama -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/nested_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16.dp">

                <!-- Kartu Status & Ping -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#162032"
                    app:cardCornerRadius="14dp"
                    app:strokeColor="#1E293B"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="14dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/iv_server_flag"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@mipmap/ic_launcher"
                            android:contentDescription="Server Icon" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_active_server_name"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Singapore Node-01"
                                android:textColor="#FFFFFF"
                                android:textStyle="bold"
                                android:textSize="15sp"
                                android:maxLines="1" />

                            <TextView
                                android:id="@+id/tv_active_server_info"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="VLESS • TLS • ws"
                                android:textColor="#94A3B8"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <!-- Baris sekitar 94 yang sering hilang layout_width -->
                        <TextView
                            android:id="@+id/tv_ping_ms"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="#1E293B"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="28 ms"
                            android:textColor="#06B6D4"
                            android:textStyle="bold"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="24dp" />

                <!-- Tombol Utama Power / Connect -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center">

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/btn_power_connect"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_gravity="center"
                        app:fabCustomSize="120dp"
                        app:maxImageSize="54dp"
                        app:tint="#06B6D4"
                        app:backgroundTint="#162032"
                        app:borderWidth="3dp"
                        app:srcCompat="@android:drawable/ic_lock_power_off"
                        android:contentDescription="Connect VPN" />
                </FrameLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="16dp" />

                <!-- Teks Status Koneksi -->
                <TextView
                    android:id="@+id/tv_connection_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="READY TO CONNECT"
                    android:textColor="#06B6D4"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:textSize="14sp" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="24dp" />

                <!-- Kartu Statistik Traffic Download & Upload -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_traffic_stats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#0F172A"
                    app:cardCornerRadius="14dp"
                    app:strokeColor="#1E293B"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="LIVE DATA TRAFFIC"
                                android:textColor="#94A3B8"
                                android:textStyle="bold"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tv_duration_timer"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="00:00:00"
                                android:textColor="#FFFFFF"
                                android:textStyle="bold"
                                android:fontFamily="monospace"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="12dp"
                            android:background="#1E293B" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <!-- Download -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="DOWNLOAD"
                                    android:textColor="#94A3B8"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/tv_download_speed"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0 KB/s"
                                    android:textColor="#22D3EE"
                                    android:textStyle="bold"
                                    android:textSize="16sp" />
                            </LinearLayout>

                            <!-- Garis Pembatas Vertikal -->
                            <View
                                android:layout_width="1dp"
                                android:layout_height="36dp"
                                android:background="#1E293B" />

                            <!-- Upload -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="UPLOAD"
                                    android:textColor="#94A3B8"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/tv_upload_speed"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0 KB/s"
                                    android:textColor="#10B981"
                                    android:textStyle="bold"
                                    android:textSize="16sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="16dp" />

                <!-- Tombol Aksi Cepat -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_servers"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="Nodes"
                        android:textColor="#FFFFFF"
                        app:strokeColor="#1E293B"
                        app:cornerRadius="10dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_tools"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="Logs"
                        android:textColor="#FFFFFF"
                        app:strokeColor="#1E293B"
                        app:cornerRadius="10dp" />
                </LinearLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="64dp" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Bottom Navigation View -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#0F172A"
            app:itemIconTint="#94A3B8"
            app:itemTextColor="#94A3B8"
            app:menu="@menu/bottom_nav_menu" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- Navigation Drawer Sidebar -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        android:background="#0F172A"
        app:headerLayout="@layout/nav_header_main"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>
