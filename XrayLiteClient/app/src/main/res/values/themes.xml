<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Sebelumnya tema ini kosong (cuma extend DayNight.NoActionBar tanpa override warna
         apa pun), jadi seluruh komponen Material (tombol, switch, toolbar) otomatis pakai
         warna default ungu bawaan Material Components; bukan bug, tapi memang belum pernah
         di-branding sama sekali. Sekarang diarahkan ke palet emas/hitam OG Tunnel. -->
    <style name="Theme.XrayLite" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">#1A1400</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorOnSecondary">#1A1400</item>
        <item name="android:windowBackground">@color/og_bg</item>
        <item name="android:colorBackground">@color/og_bg</item>
    </style>
</resources>
